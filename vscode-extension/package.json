{
  "name": "session-guardian-statusbar",
  "displayName": "Session Guardian",
  "description": "Shows Claude Code usage + Guardian state (brake, autonomy, recent activity) in the VS Code status bar and a sidebar dashboard.",
  "version": "0.4.0",
  "publisher": "dabster-labs",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/dabsterlabscy/claude-session-guardian#readme",
  "repository": { "type": "git", "url": "https://github.com/dabsterlabscy/claude-session-guardian.git" },
  "bugs": { "url": "https://github.com/dabsterlabscy/claude-session-guardian/issues" },
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Visualization", "Other"],
  "keywords": ["claude", "claude code", "usage", "rate limit", "status bar", "ai agent", "session guardian"],
  "galleryBanner": { "color": "#0b2a4a", "theme": "dark" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "sessionGuardian", "title": "Session Guardian", "icon": "media/guardian.svg" }
      ]
    },
    "views": {
      "sessionGuardian": [
        { "id": "sessionGuardian.gauge", "name": "Usage", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "sessionGuardian.showDetail", "title": "Session Guardian: Show Usage Detail" },
      { "command": "sessionGuardian.refresh", "title": "Session Guardian: Refresh Now" }
    ],
    "configuration": {
      "title": "Session Guardian",
      "properties": {
        "sessionGuardian.warnPct": { "type": "number", "default": 80, "description": "Yellow at/above this %." },
        "sessionGuardian.critPct": { "type": "number", "default": 95, "description": "Red + warning toast at/above this %." },
        "sessionGuardian.refreshSeconds": { "type": "number", "default": 30, "description": "How often to refresh from the cache." },
        "sessionGuardian.ccusageFallback": { "type": "boolean", "default": true, "description": "Run ccusage directly when the plugin cache is missing/stale." }
      }
    }
  }
}
